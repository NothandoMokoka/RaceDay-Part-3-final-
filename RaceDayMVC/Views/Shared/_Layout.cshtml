<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="~/css/site.css" />

    <style>
        body {
            background-color: #f4f6f9;
            font-family: Arial, sans-serif;
        }

        .navbar {
            background-color: #101d35;
        }

        .navbar-brand {
            color: #ffffff !important;
            font-size: 1.6rem;
            font-weight: 800;
            letter-spacing: 1px;
        }

        .navbar .nav-link {
            color: #ffffff !important;
            font-weight: 600;
        }

            .navbar .nav-link:hover {
                color: #ffc107 !important;
            }

        .race-accent {
            color: #ffc107;
        }

        footer {
            background-color: #101d35;
            color: white;
            padding: 20px;
            margin-top: 50px;
            text-align: center;
        }
    </style>
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark shadow">
            <div class="container">

                <a class="navbar-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    RACE<span class="race-accent">DAY</span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    <ul class="navbar-nav ms-auto">

                        @if (Context.Session.GetString("RoleName") == "Organizer")
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Organizer"
                                   asp-action="Index">Dashboard</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Organizer"
                                   asp-action="Events">My Events</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Organizer"
                                   asp-action="Categories">My Categories</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Organizer"
                                   asp-action="Enrolments">Manage Enrolments</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Organizer"
                                   asp-action="Results">Manage Results</a>
                            </li>
                        }
                        else if (Context.Session.GetString("RoleName") == "Participant")
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Participant"
                                   asp-action="Index">Home</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Participant"
                                   asp-action="MyEvents">My Events</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Participant"
                                   asp-action="MyResults">My Results</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Participant"
                                   asp-action="Profile">My Profile</a>
                            </li>
                        }

                        @if (Context.Session.GetInt32("UserID") != null)
                        {
                            <li class="nav-item">
                                <span class="nav-link">
                                    Hello, @Context.Session.GetString("FirstName")
                                </span>
                            </li>

                            <li class="nav-item">
                                <form asp-controller="Auth"
                                      asp-action="Logout"
                                      method="post">
                                    <button type="submit"
                                            class="btn btn-warning btn-sm mt-1">
                                        Logout
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Auth"
                                   asp-action="Login">Login</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Auth"
                                   asp-action="Register">Register</a>
                            </li>
                        }

                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer>
        <p class="mb-0">
            &copy; @DateTime.Now.Year RaceDay. All Rights Reserved.
        </p>
        <small>Run. Compete. Achieve.</small>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>