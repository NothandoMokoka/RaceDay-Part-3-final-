@model RaceDayMVC.Models.EventViewModel

@{
    ViewData["Title"] = "Edit Event";
}

<div class="container py-5">

    <div class="mb-4">
        <h1 class="fw-bold">Edit Event</h1>
        <p class="text-muted">
            Update your sporting event details.
        </p>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4 p-md-5">

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.Error
                </div>
            }

            <form asp-controller="Organizer"
                  asp-action="EditEvent"
                  method="post"
                  enctype="multipart/form-data">

                <input type="hidden" asp-for="EventID" />
                <input type="hidden" asp-for="BannerImageUrl" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold">
                        Event Name
                    </label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description"
                           class="form-label fw-semibold">
                        Description
                    </label>
                    <textarea asp-for="Description"
                              class="form-control"
                              rows="3"></textarea>
                    <span asp-validation-for="Description"
                          class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="EventDate"
                               class="form-label fw-semibold">
                            Event Date
                        </label>
                        <input asp-for="EventDate"
                               type="date"
                               class="form-control" />
                        <span asp-validation-for="EventDate"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Location"
                               class="form-label fw-semibold">
                            Location
                        </label>
                        <input asp-for="Location"
                               class="form-control" />
                        <span asp-validation-for="Location"
                              class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Distance"
                               class="form-label fw-semibold">
                            Distance (km)
                        </label>
                        <input asp-for="Distance"
                               type="number"
                               step="0.1"
                               class="form-control" />
                        <span asp-validation-for="Distance"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="EventType"
                               class="form-label fw-semibold">
                            Event Type
                        </label>
                        <select asp-for="EventType"
                                class="form-select">
                            <option value="">Select event type</option>
                            <option value="Running">Running</option>
                            <option value="Walking">Walking</option>
                            <option value="Cycling">Cycling</option>
                        </select>
                        <span asp-validation-for="EventType"
                              class="text-danger"></span>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.BannerImageUrl))
                {
                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Current Event Banner
                        </label>
                        <div>
                            <img src="@Model.BannerImageUrl"
                                 alt="Current event banner"
                                 class="img-fluid rounded-3"
                                 style="max-height:200px;" />
                        </div>
                    </div>
                }

                <div class="mb-4">
                    <label asp-for="BannerImage"
                           class="form-label fw-semibold">
                        Replace Event Banner (Optional)
                    </label>
                    <input asp-for="BannerImage"
                           type="file"
                           class="form-control"
                           accept=".jpg,.jpeg,.png,.webp" />
                    <small class="text-muted">
                        JPG, PNG or WEBP. Maximum size: 5 MB.
                        Leave empty to keep the current banner.
                    </small>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit"
                            class="btn btn-warning fw-bold">
                        Save Changes
                    </button>

                    <a asp-controller="Organizer"
                       asp-action="Events"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}