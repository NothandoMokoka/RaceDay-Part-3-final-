@model RaceDayMVC.Models.EventViewModel

@{
    ViewData["Title"] = "Create Event";
}

<div class="container py-5">

    <div class="mb-4">
        <h1 class="fw-bold">Create New Event</h1>
        <p class="text-muted">Enter the details of your sporting event below.</p>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4 p-md-5">

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">@ViewBag.Error</div>
            }

            <form asp-controller="Organizer"
                  asp-action="CreateEvent"
                  method="post"
                  enctype="multipart/form-data">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold">
                        Event Name
                    </label>
                    <input asp-for="Name" class="form-control"
                           placeholder="e.g. Johannesburg City Run" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-semibold">
                        Description
                    </label>
                    <textarea asp-for="Description" class="form-control"
                              rows="3"
                              placeholder="Describe your event"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="EventDate" class="form-label fw-semibold">
                            Event Date
                        </label>
                        <input asp-for="EventDate" type="date"
                               class="form-control" />
                        <span asp-validation-for="EventDate"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Location" class="form-label fw-semibold">
                            Location
                        </label>
                        <input asp-for="Location" class="form-control"
                               placeholder="Enter event location" />
                        <span asp-validation-for="Location"
                              class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Distance" class="form-label fw-semibold">
                            Distance (km)
                        </label>
                        <input asp-for="Distance" type="number"
                               step="0.1" min="0.1"
                               class="form-control"
                               placeholder="e.g. 10" />
                        <span asp-validation-for="Distance"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="EventType" class="form-label fw-semibold">
                            Event Type
                        </label>
                        <select asp-for="EventType" class="form-select">
                            <option value="">Select event type</option>
                            <option value="Running">Running</option>
                            <option value="Walking">Walking</option>
                            <option value="Cycling">Cycling</option>
                        </select>
                        <span asp-validation-for="EventType"
                              class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="BannerImage" class="form-label fw-semibold">
                        Event Banner (Optional)
                    </label>
                    <input asp-for="BannerImage" type="file"
                           class="form-control"
                           accept=".jpg,.jpeg,.png,.webp" />
                    <small class="text-muted">
                        JPG, PNG or WEBP. Maximum size: 5 MB.
                    </small>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-warning fw-bold">
                        Create Event
                    </button>

                    <a asp-controller="Organizer"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}