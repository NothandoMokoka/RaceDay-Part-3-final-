@model List<RaceDayMVC.Models.OrganizerResultViewModel>

@{
    ViewData["Title"] = "Manage Results";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-2">Manage Results</h2>
            <p class="text-muted mb-0">View recorded results for your events.</p>
        </div>

        <a asp-action="RecordResult" class="btn btn-warning fw-bold">
            Record Result
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Participant</th>
                            <th>Event</th>
                            <th>Category</th>
                            <th>Position</th>
                            <th>Finish Time</th>
                            <th>Recorded</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var result in Model)
                        {
                            <tr>
                                <td>@result.ParticipantName</td>
                                <td>@result.EventName</td>
                                <td>@result.CategoryName</td>
                                <td><strong>@result.FinishPosition</strong></td>
                                <td>@result.FinishTime</td>
                                <td>@result.RecordedAt.ToString("dd MMM yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            No results have been recorded for your events yet.
        </div>
    }

</div>