@model RaceDayMVC.Models.CategoryViewModel

@{
    ViewData["Title"] = "Edit Category";

    var events = ViewBag.Events as List<RaceDayMVC.Models.OrganizerEventViewModel>
                 ?? new List<RaceDayMVC.Models.OrganizerEventViewModel>();
}

<div class="container py-5">

    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">

                    <h2 class="fw-bold mb-2">Edit Category</h2>

                    <p class="text-muted mb-4">
                        Update the details of this event category.
                    </p>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">
                            @ViewBag.Error
                        </div>
                    }

                    <form asp-controller="Organizer"
                          asp-action="EditCategory"
                          method="post">

                        <input type="hidden" asp-for="CategoryID" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="EventID"
                                   class="form-label fw-semibold">
                                Select Event
                            </label>

                            <select asp-for="EventID" class="form-select">
                                <option value="">-- Select an event --</option>

                                @foreach (var eventItem in events)
                                {
                                    <option value="@eventItem.EventID">
                                        @eventItem.Name
                                    </option>
                                }
                            </select>

                            <span asp-validation-for="EventID"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CategoryName"
                                   class="form-label fw-semibold">
                                Category Name
                            </label>

                            <input asp-for="CategoryName"
                                   class="form-control" />

                            <span asp-validation-for="CategoryName"
                                  class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="MinimumAge"
                                       class="form-label fw-semibold">
                                    Minimum Age
                                </label>

                                <input asp-for="MinimumAge"
                                       type="number"
                                       class="form-control" />

                                <span asp-validation-for="MinimumAge"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="MaximumAge"
                                       class="form-label fw-semibold">
                                    Maximum Age
                                </label>

                                <input asp-for="MaximumAge"
                                       type="number"
                                       class="form-control" />

                                <span asp-validation-for="MaximumAge"
                                      class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Distance"
                                   class="form-label fw-semibold">
                                Category Distance (km)
                            </label>

                            <input asp-for="Distance"
                                   type="number"
                                   step="0.01"
                                   class="form-control" />

                            <span asp-validation-for="Distance"
                                  class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit"
                                    class="btn btn-warning fw-bold">
                                Save Changes
                            </button>

                            <a asp-action="Categories"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}