@model RaceDayMVC.Models.CategoryViewModel

@{
    ViewData["Title"] = "Delete Category";
}

<div class="container py-5">

    <div class="row justify-content-center">
        <div class="col-lg-7">

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">

                    <div class="alert alert-warning">
                        Are you sure you want to delete this category?
                        This action cannot be undone.
                    </div>

                    <h2 class="fw-bold mb-4">Delete Category</h2>

                    <h5>@Model.CategoryName</h5>

                    <p>
                        <strong>Minimum Age:</strong>
                        @(Model.MinimumAge?.ToString() ?? "Any")
                    </p>

                    <p>
                        <strong>Maximum Age:</strong>
                        @(Model.MaximumAge?.ToString() ?? "Any")
                    </p>

                    <p>
                        <strong>Distance:</strong>
                        @(Model.Distance?.ToString() ?? "Not specified")
                        @(Model.Distance.HasValue ? "km" : "")
                    </p>

                    <hr />

                    <form asp-controller="Organizer"
                          asp-action="DeleteCategoryConfirmed"
                          method="post">

                        <input type="hidden"
                               name="id"
                               value="@Model.CategoryID" />

                        <button type="submit"
                                class="btn btn-danger">
                            Yes, Delete Category
                        </button>

                        <a asp-action="Categories"
                           class="btn btn-outline-secondary ms-2">
                            Cancel
                        </a>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>