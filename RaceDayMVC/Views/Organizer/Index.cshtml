@{
    ViewData["Title"] = "Organizer Dashboard";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Organizer Dashboard</h1>
            <p class="text-muted">
                Welcome back, @Context.Session.GetString("FirstName")!
                Manage your sporting events from here.
            </p>
        </div>

        <a asp-controller="Organizer"
           asp-action="CreateEvent"
           class="btn btn-warning fw-bold">
            + Create Event
        </a>
    </div>

    <div class="row g-4 mb-5">

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <p class="text-muted mb-1">Total Events</p>
                <h2 class="fw-bold text-primary">
                    @ViewBag.TotalEvents
                </h2>
                <small class="text-muted">Events created by you</small>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <p class="text-muted mb-1">Total Enrolments</p>
                <h2 class="fw-bold text-success">
                    @ViewBag.TotalEnrollments
                </h2>
                <small class="text-muted">Participants enrolled</small>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <p class="text-muted mb-1">Upcoming Events</p>
                <h2 class="fw-bold text-warning">
                    @ViewBag.UpcomingEvents
                </h2>
                <small class="text-muted">Events scheduled ahead</small>
            </div>
        </div>

    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-bold mb-0">My Events</h4>

                <a asp-controller="Organizer"
                   asp-action="Events"
                   class="text-decoration-none">
                    View All
                </a>
            </div>

            <div class="text-center py-5">
                <div class="display-4 mb-3">🏃</div>

                <h5 class="fw-bold">View your sporting events</h5>

                <p class="text-muted">
                    Manage the events you have created.
                </p>

                <a asp-controller="Organizer"
                   asp-action="Events"
                   class="btn btn-primary">
                    View My Events
                </a>
            </div>

        </div>
    </div>

</div>