@model List<RaceDayMVC.Models.OrganizerCategoryViewModel>

@{
    ViewData["Title"] = "Manage Categories";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Manage Categories</h2>
            <p class="text-muted">Manage categories for your RaceDay events.</p>
        </div>

        <a asp-controller="Organizer"
           asp-action="CreateCategory"
           class="btn btn-warning fw-bold">
            + Add Category
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Category</th>
                            <th>Event</th>
                            <th>Minimum Age</th>
                            <th>Maximum Age</th>
                            <th>Distance</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var category in Model)
                        {
                            <tr>
                                <td class="fw-bold">
                                    @category.CategoryName
                                </td>

                                <td>@category.EventName</td>

                                <td>
                                    @(category.MinimumAge?.ToString() ?? "Any")
                                </td>

                                <td>
                                    @(category.MaximumAge?.ToString() ?? "Any")
                                </td>

                                <td>
                                    @(category.Distance?.ToString() ?? "Not specified")
                                    @(category.Distance.HasValue ? " km" : "")
                                </td>

                                <td>
                                    <a asp-action="EditCategory"
                                       asp-route-id="@category.CategoryID"
                                       class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>

                                    <a asp-action="DeleteCategory"
                                       asp-route-id="@category.CategoryID"
                                       class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 text-center p-5">
            <h5>No categories available yet</h5>
            <p class="text-muted">
                Create a category for one of your events to get started.
            </p>

            <div>
                <a asp-action="CreateCategory"
                   class="btn btn-warning fw-bold">
                    Create First Category
                </a>
            </div>
        </div>
    }

</div>