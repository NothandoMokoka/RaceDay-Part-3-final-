@model List<RaceDayMVC.Models.OrganizerEventViewModel>

@{
    ViewData["Title"] = "My Events";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">My Events</h1>
            <p class="text-muted">
                Manage all the sporting events you have created.
            </p>
        </div>

        <a asp-controller="Organizer"
           asp-action="CreateEvent"
           class="btn btn-warning fw-bold">
            + Create Event
        </a>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-warning">
            @TempData["Error"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body text-center py-5">
                <div class="display-4 mb-3">🏃</div>
                <h4 class="fw-bold">No Events Yet</h4>
                <p class="text-muted">
                    You haven't created any sporting events yet.
                </p>

                <a asp-controller="Organizer"
                   asp-action="CreateEvent"
                   class="btn btn-primary">
                    Create Your First Event
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card border-0 shadow-sm rounded-4 h-100">

                        @if (!string.IsNullOrEmpty(item.BannerImageUrl))
                        {
                            <img src="@item.BannerImageUrl"
                                 class="card-img-top"
                                 alt="@item.Name banner"
                                 style="height:200px; object-fit:cover;" />
                        }
                        else
                        {
                            <div class="bg-primary text-white text-center py-5">
                                <span class="display-3">🏅</span>
                            </div>
                        }

                    <div class="card-body p-4">

                        <h5 class="fw-bold">@item.Name</h5>

                        <p class="text-muted">
                            @item.Description
                        </p>

                        <p class="mb-2">
                            <strong>Date:</strong>
                            @item.EventDate.ToString("dd MMM yyyy")
                        </p>

                        <p class="mb-2">
                            <strong>Location:</strong>
                            @item.Location
                        </p>

                        <p class="mb-2">
                            <strong>Distance:</strong>
                            @item.Distance km
                        </p>

                        <p class="mb-3">
                            <strong>Type:</strong>
                            @item.EventType
                        </p>

                        <span class="badge bg-success">
                            @(item.EventDate.Date >= DateTime.Today
                                                    ? "Upcoming"
                                                    : "Completed")
                    </span>

                            <hr />

                            <div class="d-flex gap-2">
                                <a asp-controller="Organizer"
                                   asp-action="EditEvent"
                                   asp-route-id="@item.EventID"
                                   class="btn btn-outline-primary btn-sm flex-fill">
                                    Edit
                                </a>

                                <a asp-controller="Organizer"
                                   asp-action="DeleteEvent"
                                   asp-route-id="@item.EventID"
                                   class="btn btn-outline-danger btn-sm flex-fill">
                                    Delete
                                </a>
                            </div>

                        </div>
                    </div>
                </div>
                }

        </div>
    }

</div>