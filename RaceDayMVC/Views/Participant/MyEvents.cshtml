@model List<RaceDayMVC.Models.ParticipantEnrollmentViewModel>

@{
    ViewData["Title"] = "My Events";
}

<div class="container py-5">
    <h2 class="fw-bold mb-2">My Events</h2>
    <p class="text-muted mb-4">View your event enrolments and their current status.</p>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Category</th>
                        <th>Enrolment Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var enrollment in Model)
                    {
                        <tr>
                            <td>@enrollment.EventName</td>
                            <td>@enrollment.EventDate.ToString("dd MMM yyyy")</td>
                            <td>@enrollment.Location</td>
                            <td>@enrollment.CategoryName</td>
                            <td>@enrollment.EnrollmentDate.ToString("dd MMM yyyy")</td>
                            <td>
                                @if (enrollment.Status == "CONFIRMED")
                                {
                                    <span class="badge bg-success">CONFIRMED</span>
                                }
                                else if (enrollment.Status == "CANCELLED")
                                {
                                    <span class="badge bg-danger">CANCELLED</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">@enrollment.Status</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            You have not enrolled in any events yet.
        </div>
    }

    <a asp-action="Index" class="btn btn-warning fw-bold mt-3">
        Explore Events
    </a>
</div>