@model RaceDayMVC.Models.ParticipantEventViewModel

@{
    ViewData["Title"] = "Event Details";
    var categories = ViewBag.Categories as List<RaceDayMVC.Models.ParticipantCategoryViewModel>;
}

<div class="container py-5">
    <a asp-action="Index" class="btn btn-outline-secondary mb-4">
        Back to Events
    </a>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow border-0">
        @if (!string.IsNullOrEmpty(Model.BannerImageUrl))
        {
            <img src="@Model.BannerImageUrl"
                 class="card-img-top"
                 style="max-height:350px; object-fit:cover;"
                 alt="Event banner" />
        }

        <div class="card-body p-4">
            <h2 class="fw-bold">@Model.Name</h2>
            <p class="text-muted">@Model.Description</p>

            <p><strong>Date:</strong> @Model.EventDate.ToString("dd MMMM yyyy")</p>
            <p><strong>Location:</strong> @Model.Location</p>
            <p><strong>Distance:</strong> @Model.Distance km</p>
            <p><strong>Event Type:</strong> @Model.EventType</p>

            <hr />

            <h4 class="fw-bold mb-3">Available Categories</h4>

            @if (categories != null && categories.Any())
            {
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Category</th>
                            <th>Minimum Age</th>
                            <th>Maximum Age</th>
                            <th>Distance</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var category in categories)
                        {
                            <tr>
                                <td>@category.CategoryName</td>
                                <td>@(category.MinimumAge?.ToString() ?? "Not specified")</td>
                                <td>@(category.MaximumAge?.ToString() ?? "Not specified")</td>
                                <td>@(category.Distance?.ToString() ?? "Not specified") km</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <hr />

                <h4 class="fw-bold mb-3">Enrol in this Event</h4>

                <form asp-action="Enroll" method="post">
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="eventId" value="@Model.EventID" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">Select Category</label>

                        <select name="categoryId" class="form-select" required>
                            <option value="">Choose a category</option>
                            @foreach (var category in categories)
                            {
                                <option value="@category.CategoryID">
                                    @category.CategoryName
                                </option>
                            }
                        </select>
                    </div>

                    <button type="submit" class="btn btn-warning fw-bold">
                        Enrol Now
                    </button>
                </form>
            }
            else
            {
                <div class="alert alert-info">
                    No categories have been added to this event yet.
                </div>
            }
        </div>
    </div>
</div>