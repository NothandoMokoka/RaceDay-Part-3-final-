@model RaceDayMVC.Models.ParticipantProfileViewModel

@{
    ViewData["Title"] = "My Profile";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow border-0">
                <div class="card-body p-4">
                    <h2 class="fw-bold mb-2">My Profile</h2>
                    <p class="text-muted mb-4">View and update your personal information.</p>

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">@TempData["Success"]</div>
                    }

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">@ViewBag.Error</div>
                    }

                    @if (!string.IsNullOrEmpty(Model.ProfileImageUrl))
                    {
                        <div class="mb-3 text-center">
                            <img src="@Model.ProfileImageUrl"
                                 alt="Profile picture"
                                 class="rounded-circle"
                                 style="width:120px;height:120px;object-fit:cover;" />
                        </div>
                    }

                    <form asp-action="Profile" method="post">
                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="UserID" />
                        <input type="hidden" asp-for="Email" />
                        <input type="hidden" asp-for="ProfileImageUrl" />

                        <div class="mb-3">
                            <label asp-for="FirstName" class="form-label fw-bold">First Name</label>
                            <input asp-for="FirstName" class="form-control" />
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="LastName" class="form-label fw-bold">Last Name</label>
                            <input asp-for="LastName" class="form-control" />
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-bold">Email</label>
                            <input asp-for="Email" class="form-control" readonly />
                        </div>

                        <div class="mb-3">
                            <label asp-for="PhoneNumber" class="form-label fw-bold">Phone Number</label>
                            <input asp-for="PhoneNumber" class="form-control" />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-warning fw-bold">
                            Save Changes
                        </button>
                    </form>

                    <hr />

                    <h5 class="fw-bold mb-3">Profile Picture</h5>

                    <form asp-action="UploadProfilePicture"
                          method="post"
                          enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <input type="file"
                                   name="profileImage"
                                   class="form-control"
                                   accept=".jpg,.jpeg,.png,.webp"
                                   required />
                        </div>

                        <button type="submit" class="btn btn-outline-dark">
                            Upload Picture
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}